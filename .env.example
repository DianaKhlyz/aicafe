# ===== Режимы работы =====
# mock  — демо-данные, всё работает без внешних сервисов (по умолчанию)
# cloud — боевой iikoCloud API
IIKO_MODE=mock

# ===== iikoCloud (нужны только при IIKO_MODE=cloud) =====
# apiLogin из личного кабинета iiko (секрет!)
IIKO_API_LOGIN=
# id организации: POST /api/1/organizations
IIKO_ORGANIZATION_ID=
# id группы терминалов: POST /api/1/terminal_groups
IIKO_TERMINAL_GROUP_ID=
# id типа оплаты «онлайн» из POST /api/1/payment_types
IIKO_ONLINE_PAYMENT_TYPE_ID=
# токен, которым iiko подписывает вебхуки (задаётся в настройках вебхука)
IIKO_WEBHOOK_AUTH_TOKEN=

# ===== Эквайринг =====
# mock | yookassa
PAYMENT_PROVIDER=mock
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# ===== Фичефлаги (переопределяют значения по умолчанию из src/lib/config.ts) =====
# FEATURE_BOOKING=true
# FEATURE_LOYALTY=false
# FEATURE_PREORDER=false
# FEATURE_QR_TABLE=false
# FEATURE_REVIEWS=false

# ===== Прочее =====
# Публичный адрес сайта (для ссылок в уведомлениях и return_url оплаты)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
