# Скопируйте в .env и заполните. Все переменные читаются с префиксом AICAFE_.

# Режим iiko: пока нет apiLogin — работаем на мок-данных
AICAFE_IIKO_MOCK=true
AICAFE_IIKO_API_LOGIN=
AICAFE_IIKO_ORGANIZATION_IDS=[]
# Пусто = определяются автоматически (терминальная группа, внешнее меню)
AICAFE_IIKO_TERMINAL_GROUP_ID=
AICAFE_IIKO_EXTERNAL_MENU_ID=
AICAFE_IIKO_TERMINAL_TIMEZONE=Europe/Moscow
# Публичный URL вебхуков + секрет (iiko шлёт его в заголовке Authorization)
AICAFE_IIKO_WEBHOOK_URL=
AICAFE_IIKO_WEBHOOK_AUTH_TOKEN=

# DaData: пусто = мок-подсказки; ключ на аккаунте заказчика, тариф бесплатный
AICAFE_DADATA_API_KEY=

# Путь к файлу SQLite
AICAFE_DATABASE_PATH=aicafe.db

# Разрешённые origin для CORS (dev-сервер Vite)
AICAFE_CORS_ORIGINS=["http://localhost:5173"]
