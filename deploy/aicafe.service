# systemd-юнит бэкенда. Устанавливается setup.sh в /etc/systemd/system/.
[Unit]
Description=AI Cafe backend (FastAPI BFF)
After=network.target

[Service]
Type=simple
User=aicafe
WorkingDirectory=/opt/aicafe/backend
# .env читает и systemd (дефис = файл может отсутствовать), и pydantic-settings
EnvironmentFile=-/opt/aicafe/backend/.env
# Строго один воркер: SSE-шина, кэш меню и корзины столов живут в памяти
# процесса. Масштабирование на несколько воркеров = Redis pub/sub (см.
# app/events.py), сейчас не нужно — один процесс держит кафе с запасом.
ExecStart=/usr/local/bin/uv run uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

# Минимальное ужесточение
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/aicafe/backend

[Install]
WantedBy=multi-user.target
